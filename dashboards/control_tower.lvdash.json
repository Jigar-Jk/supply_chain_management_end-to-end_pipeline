{
    "datasets": [
        {
            "name": "headline",
            "displayName": "Headline KPIs (last 30 days)",
            "queryLines": [
                "WITH w AS (SELECT max(kpi_date) AS d FROM gold.vw_otif_daily) ",
                "SELECT ",
                "  (SELECT round(100.0 * sum(otif_shipments) / nullif(sum(shipments_delivered), 0), 1) FROM gold.vw_otif_daily, w WHERE kpi_date > date_sub(w.d, 30)) AS otif_pct, ",
                "  (SELECT round(100.0 * sum(units_shipped) / nullif(sum(units_ordered), 0), 1) FROM gold.vw_fill_rate_daily, w WHERE kpi_date > date_sub(w.d, 30)) AS fill_rate_pct, ",
                "  (SELECT round(100.0 * sum(stockout_skus) / nullif(sum(skus_stocked), 0), 1) FROM gold.vw_stockout_rate_daily WHERE kpi_date = (SELECT max(kpi_date) FROM gold.vw_stockout_rate_daily)) AS stockout_rate_pct, ",
                "  (SELECT round(avg(inventory_turnover), 1) FROM gold.vw_inventory_turnover_daily WHERE kpi_date = (SELECT max(kpi_date) FROM gold.vw_inventory_turnover_daily)) AS inventory_turnover"
            ]
        },
        {
            "name": "daily",
            "displayName": "OTIF and fill rate by day",
            "queryLines": [
                "SELECT o.kpi_date, ",
                "  round(100.0 * sum(o.otif_shipments) / nullif(sum(o.shipments_delivered), 0), 1) AS otif_pct, ",
                "  round(100.0 * sum(f.units_shipped) / nullif(sum(f.units_ordered), 0), 1) AS fill_rate_pct ",
                "FROM gold.vw_otif_daily o ",
                "LEFT JOIN gold.vw_fill_rate_daily f ON f.warehouse_id = o.warehouse_id AND f.kpi_date = o.kpi_date ",
                "GROUP BY o.kpi_date ORDER BY o.kpi_date"
            ]
        },
        {
            "name": "by_warehouse",
            "displayName": "OTIF by warehouse (last 30 days)",
            "queryLines": [
                "SELECT warehouse_name, ",
                "  round(sum(shipments_delivered * otif_pct) / nullif(sum(shipments_delivered), 0), 1) AS otif_pct, ",
                "  sum(shipments_delivered) AS shipments ",
                "FROM gold.mart_logistics_kpi_daily ",
                "WHERE kpi_date > date_sub((SELECT max(kpi_date) FROM gold.mart_logistics_kpi_daily), 30) AND shipments_delivered > 0 ",
                "GROUP BY warehouse_name ORDER BY otif_pct LIMIT 15"
            ]
        },
        {
            "name": "delay_risk",
            "displayName": "Shipments at high delay risk",
            "queryLines": [
                "SELECT shipment_id, carrier_name, warehouse_id, planned_delivery_time, delay_risk_score, risk_band ",
                "FROM gold.vw_delivery_delay_risk WHERE risk_band = 'HIGH' ORDER BY delay_risk_score DESC LIMIT 50"
            ]
        },
        {
            "name": "by_carrier",
            "displayName": "OTIF by carrier vs contract (last 30 days)",
            "queryLines": [
                "SELECT carrier_name, ",
                "  sum(shipments_delivered) AS shipments, ",
                "  round(100.0 * sum(otif_shipments) / nullif(sum(shipments_delivered), 0), 1) AS otif_pct, ",
                "  max(contracted_otif_target) AS target_pct, ",
                "  round(100.0 * sum(otif_shipments) / nullif(sum(shipments_delivered), 0) - max(contracted_otif_target), 1) AS gap_pct ",
                "FROM gold.vw_otif_by_carrier_daily ",
                "WHERE kpi_date > date_sub((SELECT max(kpi_date) FROM gold.vw_otif_by_carrier_daily), 30) ",
                "GROUP BY carrier_name ORDER BY gap_pct"
            ]
        },
        {
            "name": "dq_volume",
            "displayName": "DQ 1: volume vs quarantined (14 days)",
            "queryLines": [
                "WITH processed AS (\n",
                "  SELECT 'orders'     AS source_feed, to_date(_ingest_timestamp) AS day, count(*) AS rows_processed FROM bronze.orders     GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'inventory',  to_date(_ingest_timestamp), count(*) FROM bronze.inventory  GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'shipments',  to_date(_ingest_timestamp), count(*) FROM bronze.shipments  GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'warehouses', to_date(_ingest_timestamp), count(*) FROM bronze.warehouses GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'products',   to_date(_ingest_timestamp), count(*) FROM bronze.products   GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'customers',  to_date(_ingest_timestamp), count(*) FROM bronze.customers  GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'carriers',   to_date(_ingest_timestamp), count(*) FROM bronze.carriers   GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'routes',     to_date(_ingest_timestamp), count(*) FROM bronze.routes     GROUP BY to_date(_ingest_timestamp)\n",
                "  UNION ALL\n",
                "  SELECT 'gps_events', to_date(_ingest_timestamp), count(*) FROM bronze.gps_events GROUP BY to_date(_ingest_timestamp)\n",
                "),\n",
                "quarantined AS (\n",
                "  SELECT source_feed, to_date(ingested_at) AS day, count(*) AS rows_quarantined\n",
                "  FROM quarantine.records\n",
                "  GROUP BY source_feed, to_date(ingested_at)\n",
                ")\n",
                "SELECT\n",
                "  p.day,\n",
                "  p.source_feed,\n",
                "  p.rows_processed,\n",
                "  coalesce(q.rows_quarantined, 0)                                            AS rows_quarantined,\n",
                "  round(100.0 * coalesce(q.rows_quarantined, 0) / nullif(p.rows_processed, 0), 2) AS quarantine_pct\n",
                "FROM processed p\n",
                "LEFT JOIN quarantined q ON q.source_feed = p.source_feed AND q.day = p.day\n",
                "WHERE p.day >= date_sub(current_date(), 14)\n"
            ]
        },
        {
            "name": "dq_by_rule",
            "displayName": "DQ 2: quarantine by rule",
            "queryLines": [
                "SELECT\n",
                "  source_feed,\n",
                "  failed_rule,\n",
                "  status,\n",
                "  count(*)              AS rows,\n",
                "  min(ingested_at)      AS oldest,\n",
                "  max(retry_count)      AS max_retries\n",
                "FROM quarantine.records\n",
                "GROUP BY source_feed, failed_rule, status\n"
            ]
        },
        {
            "name": "dq_reprocessing",
            "displayName": "DQ 3: reprocessing success",
            "queryLines": [
                "WITH by_feed AS (\n",
                "  SELECT\n",
                "    source_feed,\n",
                "    sum(CASE WHEN status = 'REPROCESSED' THEN 1 ELSE 0 END) AS reprocessed,\n",
                "    sum(CASE WHEN status = 'REJECTED'    THEN 1 ELSE 0 END) AS rejected,\n",
                "    sum(CASE WHEN status = 'PENDING'     THEN 1 ELSE 0 END) AS still_pending\n",
                "  FROM quarantine.records\n",
                "  GROUP BY source_feed\n",
                "),\n",
                "with_total AS (\n",
                "  SELECT * FROM by_feed\n",
                "  UNION ALL\n",
                "  SELECT 'ALL', sum(reprocessed), sum(rejected), sum(still_pending) FROM by_feed\n",
                ")\n",
                "SELECT\n",
                "  source_feed,\n",
                "  reprocessed,\n",
                "  rejected,\n",
                "  still_pending,\n",
                "  round(100.0 * reprocessed / nullif(reprocessed + rejected, 0), 2) AS reprocessing_success_pct\n",
                "FROM with_total\n"
            ]
        },
        {
            "name": "dq_sla",
            "displayName": "DQ 4: pipeline SLA status",
            "queryLines": [
                "WITH last_success AS (\n",
                "  SELECT source_system, max(ended_at) AS last_success\n",
                "  FROM ops.pipeline_run_log\n",
                "  WHERE status = 'SUCCESS'\n",
                "  GROUP BY source_system\n",
                "),\n",
                "recent_miss AS (\n",
                "  SELECT source_system, max(ended_at) AS last_sla_miss, max_by(error_message, ended_at) AS miss_message\n",
                "  FROM ops.pipeline_run_log\n",
                "  WHERE status IN ('SLA_MISS', 'REJECTED_FILE') AND ended_at >= current_timestamp() - INTERVAL 24 HOURS\n",
                "  GROUP BY source_system\n",
                "),\n",
                "lag AS (\n",
                "  SELECT\n",
                "    c.source_system,\n",
                "    c.expected_by_time,\n",
                "    c.max_lag_minutes,\n",
                "    l.last_success,\n",
                "    m.last_sla_miss,\n",
                "    m.miss_message,\n",
                "    CAST((unix_timestamp(current_timestamp()) - unix_timestamp(l.last_success)) / 60 AS INT) AS minutes_since_success\n",
                "  FROM ops.sla_config c\n",
                "  LEFT JOIN last_success l ON l.source_system = c.source_system\n",
                "  LEFT JOIN recent_miss  m ON m.source_system = c.source_system\n",
                ")\n",
                "SELECT\n",
                "  source_system,\n",
                "  expected_by_time,\n",
                "  max_lag_minutes,\n",
                "  last_success,\n",
                "  minutes_since_success,\n",
                "  last_sla_miss,\n",
                "  miss_message,\n",
                "  CASE WHEN last_sla_miss IS NOT NULL\n",
                "         OR last_success IS NULL\n",
                "         OR minutes_since_success > 2 * max_lag_minutes THEN 'RED'\n",
                "       WHEN minutes_since_success > max_lag_minutes     THEN 'AMBER'\n",
                "       ELSE 'GREEN' END                                  AS sla_status\n",
                "FROM lag\n"
            ]
        }
    ],
